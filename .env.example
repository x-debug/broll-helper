# OpenRouter API Key（必填，从 https://openrouter.ai/keys 获取）
OPENROUTER_API_KEY=sk-or-...

# OpenRouter 使用的模型（默认 openai/gpt-4o-mini）
# 可选示例：
#   openai/gpt-4o
#   anthropic/claude-3.5-haiku
#   google/gemini-flash-1.5
OPENROUTER_MODEL=openai/gpt-4o-mini

# HTTP 代理（如果需要通过代理访问 OpenRouter，取消注释并填写）
# http_proxy=http://127.0.0.1:1087
# https_proxy=http://127.0.0.1:1087

# 可选：你的网站地址（OpenRouter 用于统计来源）
OPENROUTER_SITE_URL=https://github.com/broll-helper

# 可选：你的应用名称（在 OpenRouter 控制台显示）
OPENROUTER_APP_NAME=broll-helper

# Pexels API Key（从 https://www.pexels.com/api/ 申请）
PEXELS_API_KEY=...

# Pixabay API Key（从 https://pixabay.com/api/docs/ 申请）
PIXABAY_API_KEY=...
